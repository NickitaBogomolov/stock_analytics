!pragma layout smetana
skinparam dpi 160
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #52514E
skinparam ClassBorderColor #2A78D6
skinparam ClassBackgroundColor #F3F8FE
skinparam ClassHeaderBackgroundColor #DCEAFB
skinparam EntityBorderColor #2A78D6
skinparam EntityBackgroundColor #F3F8FE
skinparam PackageBorderColor #898781
skinparam PackageBackgroundColor #FCFCFB
skinparam ComponentBorderColor #2A78D6
skinparam ComponentBackgroundColor #F3F8FE
skinparam UsecaseBorderColor #2A78D6
skinparam UsecaseBackgroundColor #F3F8FE
skinparam ActorBorderColor #0B0B0B
skinparam ActivityBorderColor #2A78D6
skinparam ActivityBackgroundColor #F3F8FE
skinparam ActivityDiamondBorderColor #EB6834
skinparam ActivityDiamondBackgroundColor #FFF4EE
skinparam ParticipantBorderColor #2A78D6
skinparam ParticipantBackgroundColor #F3F8FE
skinparam SequenceLifeLineBorderColor #898781
skinparam NoteBackgroundColor #FFF9E6
skinparam NoteBorderColor #EDA100
skinparam roundcorner 8
