@startuml use-case
!include _style.iuml
left to right direction
title Диаграмма вариантов использования

actor "Аналитик /\nчастный инвестор" as User
actor "Преподаватель /\nразработчик" as Dev

rectangle "Market Analytics (веб-приложение)" {
  usecase "UC-1 Просмотреть список\nинструментов" as UC1
  usecase "UC-2 Проанализировать\nинструмент" as UC2
  usecase "UC-3 Настроить параметры\n(SMA, RSI, ставка)" as UC3
  usecase "UC-4 Загрузить собственный\nCSV с котировками" as UC4
  usecase "UC-5 Сравнить несколько\nинструментов" as UC5
  usecase "UC-6 Запустить расчёт\nв лаборатории C++" as UC6
  usecase "Бэктест с подбором\nпараметров" as UC6a
  usecase "Монте-Карло:\nVaR / CVaR" as UC6b
  usecase "Оптимизация\nпортфеля" as UC6c
  usecase "UC-8 Добавить бумагу\nс Мосбиржи" as UC8
  usecase "Проверить данные\n(валидация CSV)" as UCV
  usecase "Построить графики\nи сигналы" as UCG
}
rectangle "Консоль" {
  usecase "UC-7 Получить отчёт\nчерез market_cli" as UC7
}

User --> UC1
User --> UC2
User --> UC4
User --> UC5
User --> UC6
User --> UC8
UC6a .up.> UC6 : <<extend>>
UC6b .up.> UC6 : <<extend>>
UC6c .up.> UC6 : <<extend>>
Dev --> UC7
UC2 ..> UCG : <<include>>
UC4 ..> UCV : <<include>>
UC4 ..> UC2 : <<include>>
UC3 ..> UC2 : <<extend>>
UC7 ..> UCV : <<include>>
@enduml
